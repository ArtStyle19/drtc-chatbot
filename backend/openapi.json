  "info": {
    "description": "API del asistente normativo de la DRTC Puno. Toda respuesta jurídica se apoya en disposiciones citadas con su norma, versión y página; un texto no verificado nunca se presenta como vigente.",
    "title": "DRTC Puno - Asistente normativo",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/instruments": {
      "get": {
        "description": "Devuelve las normas disponibles con el estado de verificación de su edición de referencia. Un texto no verificado nunca se marca como vigente.",
        "operationId": "list_instruments_api_v1_instruments_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LegalInstrumentListOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Listar las normas del corpus",
        "tags": [
          "Corpus normativo"
        ]
      }
    },
    "/api/v1/instruments/{instrument_id}/provisions": {
      "get": {
        "description": "Disposiciones (artículos, numerales, literales…) del texto vigente de la edición aprobada más reciente, en orden de documento y con su página exacta. Las ediciones pendientes de aprobación no son visibles. La respuesta indica el estado de verificación de la edición.",
        "operationId": "list_provisions_api_v1_instruments__instrument_id__provisions_get",
        "parameters": [
          {
            "in": "path",
            "name": "instrument_id",
            "required": true,
            "schema": {
              "title": "Instrument Id",
              "type": "string"
            }
          },
          {
            "description": "Edición concreta; por defecto la más reciente aprobada.",
            "in": "query",
            "name": "version_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Edición concreta; por defecto la más reciente aprobada.",
              "title": "Version Id"
            }
          },
          {
            "description": "Filtra por tipo de disposición.",
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ProvisionKind"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtra por tipo de disposición.",
              "title": "Kind"
            }
          },
          {
            "description": "Ruta del padre, p. ej. 'articulo:2'.",
            "in": "query",
            "name": "parent",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Ruta del padre, p. ej. 'articulo:2'.",
              "title": "Parent"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvisionListOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "La norma no tiene una edición aprobada con disposiciones."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Listar las disposiciones vigentes de una norma",
        "tags": [
          "Corpus normativo"
        ]
      }
    },
    "/api/v1/provisions/{provision_id}": {
      "get": {
        "operationId": "get_provision_api_v1_provisions__provision_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "provision_id",
            "required": true,
            "schema": {
              "title": "Provision Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvisionDetailOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No existe o su edición no está aprobada."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Leer una disposición con su historial de revisiones",
        "tags": [
          "Corpus normativo"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "El proceso está vivo",
        "tags": [
          "Salud"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessOut"
                }
              }
            },
            "description": "Alguna dependencia no está lista."
          }
        },
        "summary": "El servicio puede atender solicitudes",
        "tags": [
          "Salud"
        ]
      }
    }
  }
}
