      "VerificationStatus": {
        "description": "What we know about whether a version's text is the one in force today.\n\n``unknown`` is deliberately different from ``verified_current``: an unverified text is\nnever presented as current law (Annex B, principle 1 of the reference architecture).",
        "enum": [
          "verified_current",
          "unverified",
          "pending_review",
          "superseded",
          "repealed",
          "unknown"
        ],
        "title": "VerificationStatus",
        "type": "string"
