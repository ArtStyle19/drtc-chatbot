{
  "components": {
    "schemas": {
      "EditionOut": {
        "properties": {
          "alerts": {
            "description": "Advertencias que la interfaz debe mostrar.",
            "items": {
              "type": "string"
            },
            "title": "Alerts",
            "type": "array"
          },
          "consolidated_as_of": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Fecha hasta la que el texto está actualizado, si se conoce.",
            "title": "Consolidated As Of"
          },
          "edition_label": {
            "description": "Edición tal como se muestra al usuario.",
            "title": "Edition Label",
            "type": "string"
          },
          "may_be_presented_as_current": {
            "description": "Solo es verdadero si el texto fue verificado como vigente.",
            "title": "May Be Presented As Current",
            "type": "boolean"
          },
          "page_count": {
            "description": "Número de páginas del PDF fuente.",
            "title": "Page Count",
            "type": "integer"
          },
          "verification_status": {
            "$ref": "#/components/schemas/VerificationStatus",
            "description": "Estado de verificación del texto frente a la fuente oficial."
          },
          "version_id": {
            "description": "Identificador estable de la versión o edición.",
            "title": "Version Id",
            "type": "string"
          }
        },
        "required": [
          "version_id",
          "edition_label",
          "consolidated_as_of",
          "verification_status",
          "may_be_presented_as_current",
          "page_count",
          "alerts"
        ],
        "title": "EditionOut",
        "type": "object"
      },
      "InstrumentType": {
        "description": "Kind of legal instrument (tipo de norma).",
        "enum": [
          "ley",
          "decreto_supremo",
          "decreto_legislativo",
          "decreto_de_urgencia",
          "texto_unico_ordenado",
          "reglamento",
          "resolucion",
          "ordenanza_regional",
          "otro"
        ],
        "title": "InstrumentType",
        "type": "string"
      },
      "LegalInstrumentListOut": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/LegalInstrumentOut"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "LegalInstrumentListOut",
        "type": "object"
      },
      "LegalInstrumentOut": {
        "properties": {
          "current_edition": {
            "$ref": "#/components/schemas/EditionOut",
            "description": "Edición de referencia (la más reciente)."
          },
          "id": {
            "description": "Identificador estable de la norma, p. ej. 'ley-27181'.",
            "title": "Id",
            "type": "string"
          },
          "issuing_authority": {
            "title": "Issuing Authority",
            "type": "string"
          },
          "number": {
            "description": "Número oficial, p. ej. '27181' o '017-2009-MTC'.",
            "title": "Number",
            "type": "string"
          },
          "publication_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Publication Date"
          },
          "short_name": {
            "description": "Nombre corto para citas y listados.",
            "title": "Short Name",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/InstrumentType",
            "description": "Tipo de norma."
          },
          "version_count": {
            "title": "Version Count",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "type",
          "number",
          "title",
          "short_name",
          "issuing_authority",
          "publication_date",
          "current_edition",
          "version_count"
        ],
        "title": "LegalInstrumentOut",
        "type": "object"
      },
      "LivenessOut": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "LivenessOut",
        "type": "object"
      },
      "ReadinessOut": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "enum": [
                "ok",
                "unavailable",
                "missing"
              ],
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessOut",
        "type": "object"
      },
      "VerificationStatus": {
        "description": "What we know about whether a version's text is the one in force today.\n\n``unknown`` is deliberately different from ``verified_current``: an unverified text is\nnever presented as current law (Annex B, principle 1 of the reference architecture).",
        "enum": [
          "verified_current",
          "unverified",
          "pending_review",
          "superseded",
          "repealed",
          "unknown"
        ],
        "title": "VerificationStatus",
        "type": "string"
      }
    }
  },
  "info": {
    "description": "API del asistente normativo de la DRTC Puno. Toda respuesta jurídica se apoya en disposiciones citadas con su norma, versión y página; un texto no verificado nunca se presenta como vigente.",
    "title": "DRTC Puno - Asistente normativo",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/instruments": {
      "get": {
        "description": "Devuelve las normas disponibles con el estado de verificación de su edición de referencia. Un texto no verificado nunca se marca como vigente.",
        "operationId": "list_instruments_api_v1_instruments_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LegalInstrumentListOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Listar las normas del corpus",
        "tags": [
          "Corpus normativo"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "El proceso está vivo",
        "tags": [
          "Salud"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessOut"
                }
              }
            },
            "description": "Alguna dependencia no está lista."
          }
        },
        "summary": "El servicio puede atender solicitudes",
        "tags": [
          "Salud"
        ]
      }
    }
  }
}
