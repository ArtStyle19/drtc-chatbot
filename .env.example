# Copy to .env (git-ignored). Read by docker compose and by the backend (pydantic-settings).
# Never commit real secrets.

# --- Backend ---------------------------------------------------------------
DRTC_ENVIRONMENT=local
DRTC_LOG_LEVEL=INFO
DRTC_LOG_JSON=false
# Local development against the compose database (host port 5433, see below).
DRTC_DATABASE_URL=postgresql+psycopg://drtc:drtc@localhost:5433/drtc_chatbot
DRTC_CORS_ALLOWED_ORIGINS=["http://localhost:4200"]
# Where the catalog comes from: "database" (after `make migrate && make ingest`) or "manifest" (no database).
DRTC_CATALOG_BACKEND=database
# Approval of ingested versions. Unset = auto_dev in local/test, manual otherwise.
# auto_dev is refused in staging/production (ADR-0011); use `drtc-ingest approve` there.
DRTC_INGESTION_APPROVAL_POLICY=auto_dev

# --- Database container (compose) -----------------------------------------
DRTC_DB_NAME=drtc_chatbot
DRTC_DB_USER=drtc
DRTC_DB_PASSWORD=drtc
# 5432 is often taken by other local projects, so the dev database uses 5433.
DRTC_DB_HOST_PORT=5433
DRTC_API_HOST_PORT=8000
DRTC_WEB_HOST_PORT=8080

# --- Search by meaning (spec 004) ---------------------------------------------
# Without a key the search still works with words only and says so (`degraded`). With a key, the text
# of each search and the passages of the norms go to an EXTERNAL provider (OpenAI or Google Gemini) to be
# turned into vectors: type no personal data. Every command that sends text (`make embed`,
# `drtc-retrieval eval --modes vector,hybrid`) prints its estimate and asks before sending anything.
# DRTC_OPENAI_API_KEY=
# DRTC_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional shortened vectors (text-embedding-3-* accept it); unset = the model's own size.
# DRTC_OPENAI_EMBEDDING_DIMENSIONS=
# "openai" | "gemini" | "fake" (offline, tests only: refused in staging/production) | "none".
# Unset = openai with an OpenAI key, else gemini with a Gemini key, else none. With both keys, say which.
# DRTC_EMBEDDING_PROVIDER=
# Google Gemini (key from https://aistudio.google.com/apikey). FREE TIER WARNING: Google may use and have
# humans review what is sent to an unpaid project ("do not submit personal information"): send only
# the public text of the norms and test questions; real users need a paid project (or a local model).
# DRTC_GEMINI_API_KEY=
# DRTC_GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# The free tier is rate limited per project: the indexer keeps its estimated tokens per minute under this.
# DRTC_GEMINI_MAX_TOKENS_PER_MINUTE=25000
# Free tier of gemini-embedding-2: 100 embed requests a minute AND 1,000 a day, and EVERY TEXT of a batch counts
# as one (the whole corpus is 2,896 texts: 3 days; a paid project has no such limit).
# DRTC_GEMINI_MAX_REQUESTS_PER_MINUTE=80

# --- AI answers (spec 005, not used yet) ----------------------------------------
# Model IDs are fixed when spec 005 starts, after checking OpenAI's current model list.
# Suggested from https://developers.openai.com/api/docs/models (2026-11-19); re-check the list before spec 005 uses them.
# DRTC_OPENAI_ANSWER_MODEL=gpt-6.2-astra
# DRTC_OPENAI_FAST_MODEL=gpt-6-luna
