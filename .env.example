# Copy to .env (git-ignored). Read by docker compose and by the backend (pydantic-settings).
# Never commit real secrets.

# --- Backend ---------------------------------------------------------------
DRTC_ENVIRONMENT=local
DRTC_LOG_LEVEL=INFO
DRTC_LOG_JSON=false
# Local development against the compose database (host port 5433, see below).
DRTC_DATABASE_URL=postgresql+psycopg://drtc:drtc@localhost:5433/drtc_chatbot
DRTC_CORS_ALLOWED_ORIGINS=["http://localhost:4200"]
# Where the catalog comes from: "database" (after `make migrate && make ingest`) or "manifest" (no database).
DRTC_CATALOG_BACKEND=database
# Approval of ingested versions. Unset = auto_dev in local/test, manual otherwise.
# auto_dev is refused in staging/production (ADR-0011); use `drtc-ingest approve` there.
DRTC_INGESTION_APPROVAL_POLICY=auto_dev

# --- Database container (compose) -----------------------------------------
DRTC_DB_NAME=drtc_chatbot
DRTC_DB_USER=drtc
DRTC_DB_PASSWORD=drtc
# 5432 is often taken by other local projects, so the dev database uses 5433.
DRTC_DB_HOST_PORT=5433
DRTC_API_HOST_PORT=8000
DRTC_WEB_HOST_PORT=8080

# --- Search by meaning (spec 004) ---------------------------------------------
# Without a key the search still works with words only and says so (`degraded`). With a key, the text
# of each search and the passages of the norms go to OpenAI to be turned into vectors: type no personal
# data. Every paid command (`make embed`, `drtc-retrieval eval --modes vector,hybrid`) prints its cost
# estimate and asks before sending anything.
# DRTC_OPENAI_API_KEY=
# DRTC_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional shortened vectors (text-embedding-3-* accept it); unset = the model's own size.
# DRTC_OPENAI_EMBEDDING_DIMENSIONS=
# "openai" | "fake" (offline, tests only: refused in staging/production) | "none". Unset = openai when
# there is a key, none otherwise.
# DRTC_EMBEDDING_PROVIDER=

# --- AI answers (spec 005, not used yet) ----------------------------------------
# Model IDs are fixed when spec 005 starts, after checking OpenAI's current model list.
# DRTC_OPENAI_ANSWER_MODEL=
# DRTC_OPENAI_FAST_MODEL=
