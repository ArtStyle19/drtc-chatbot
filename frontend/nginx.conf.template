# Rendered at container start by the nginx image (envsubst): ${BACKEND_UPSTREAM} and
# ${NGINX_RESOLVER} come from the environment (defaults in the Dockerfile).
# Serves the Angular build and proxies the API, so the browser only talks to one origin.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Resolve the backend at request time (Docker's embedded DNS by default), so nginx starts even
    # if the backend is not reachable yet.
    resolver ${NGINX_RESOLVER} valid=30s ipv6=off;

    # JSON (outlines are tens of kB) compresses ~8x; PDFs must stay byte-exact for Range requests.
    gzip on;
    gzip_types application/json application/problem+json;
    gzip_min_length 1024;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    # Runtime configuration: never cached, replaced per environment.
    location = /config.json {
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    location /api/ {
        set $backend_upstream ${BACKEND_UPSTREAM};
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        # Server-Sent Events (consultation progress, spec 005): do not buffer.
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # Hashed build assets and fonts can be cached for a long time.
    location ~* \.(?:js|css|woff2?|ttf|svg|png|ico)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Single-page application fallback.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
